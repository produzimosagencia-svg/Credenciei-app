# Copie para .env (nunca commitado — já está no .gitignore) e preencha com
# valores de verdade antes de rodar `npm run dev`.

# ─── Supabase — o MESMO banco do credenciei-web ──────────────────────────────
# Project Settings > API, no painel do Supabase. A service role key tem
# acesso total ao banco (ignora RLS) — nunca vai pro app, nunca é exposta ao
# navegador. Só esta API a usa.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── QR da credencial ─────────────────────────────────────────────────────────
# Uma string qualquer, longa e aleatória — assina o QR (ver
# packages/dominio/src/credencial-qr.ts). Gere uma vez e nunca troque
# (trocar invalida todo crachá em circulação). Ex.: openssl rand -hex 32
SEGREDO_QR=

# Formato novo do QR (c4), Ed25519 — ver docs/decisoes/009-qr-offline-ed25519.md.
# OPCIONAL por enquanto: sem ela, nada muda (o sistema continua só no c3).
# Só a chave PÚBLICA vai aqui — 32 bytes em hexadecimal (64 caracteres). Gere
# o par com (rode uma vez, guarde os dois valores, e NUNCA cole a privada
# aqui nem em nenhum outro .env.example):
#   node -e "const{ed25519}=require('@noble/curves/ed25519');const p=ed25519.utils.randomPrivateKey();console.log('privada:',Buffer.from(p).toString('hex'));console.log('publica:',Buffer.from(ed25519.getPublicKey(p)).toString('hex'))"
# A privada correspondente é CHAVE_PRIVADA_QR_ED25519 — ainda não usada por
# nada nesta API (só entra em uso na fase 3 do ADR 009, quando o sistema
# passar a GERAR c4, não só aceitar).
CHAVE_PUBLICA_QR_ED25519=
CHAVE_PRIVADA_QR_ED25519=

# ─── Onde esta API responde ───────────────────────────────────────────────────
PORT=3001
# O endereço que o link de download de relatório usa (ver src/arquivos.ts).
# Em local, deixe como http://localhost:PORT.
API_URL=http://localhost:3001

# O domínio do site (credenciei-web) — monta o link do cartaz da portaria e
# do formulário de cadastro do setor. Sem esta variável, usa o de produção.
# SITE_URL=https://credenciei.vercel.app

# ─── WhatsApp (o código de entrar) ────────────────────────────────────────────
# Sem estas três, o código só aparece no terminal (nada é enviado de verdade)
# — é o padrão até você ter um template de AUTENTICAÇÃO aprovado na Meta
# Business Manager. Mesma conta/número que o credenciei-web usa.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE_CODIGO=entrar_codigo

# Interruptor de emergência — mesma variável que o site usa. "true" para
# TUDO de propósito, mesmo com as três de cima preenchidas.
# WHATSAPP_PAUSADO=false
