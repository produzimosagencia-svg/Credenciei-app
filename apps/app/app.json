{
  "expo": {
    "name": "Credenciei",
    "slug": "credenciei",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "credenciei",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.produzimos.credenciei"
    },
    "android": {
      "package": "com.produzimos.credenciei",
      "adaptiveIcon": {
        "backgroundColor": "#4940df",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "O Credenciei usa a câmera para ler o QR da credencial no portão e para tirar a foto que valida quem registrou o ponto.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A localização fica guardada junto com a batida registrada por outra pessoa, como prova de onde ela aconteceu. Se você negar, o registro funciona do mesmo jeito."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
